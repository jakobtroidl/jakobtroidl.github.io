<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div
      class="table-responsive"
      {% if include.limit and site.announcements.scrollable and news_size > 3 %}
        style="max-height: 60vw"
      {% endif %}
    >
      <table class="table table-sm table-borderless">
        {% assign news = site.news | reverse %}
        {% if include.limit and site.announcements.limit %}
          {% assign news_limit = site.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news %}
          {% if forloop.index0 == news_limit %}
            {% comment %} older news goes in its own table so its height can be animated {% endcomment %}
            </table>
            <div class="news-more" id="news-more" inert>
            <table class="table table-sm table-borderless">
          {% endif %}
          <tr
            {% if forloop.index > news_limit %}
              style="--i: {{ forloop.index | minus: news_limit }}"
            {% endif %}
          >
            <th scope="row" style="width: 20%">{{ item.date | date: '%b %d, %Y' }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
      {% if news_size > news_limit %}
        </div>
      {% endif %}
    </div>
    {% if news_size > news_limit %}
      <button type="button" class="news-toggle" aria-expanded="false" aria-controls="news-more">
        {% assign news_hidden = news_size | minus: news_limit %}
        <span class="news-toggle-label" data-more="Show {{ news_hidden }} older updates">Show {{ news_hidden }} older updates</span>
        <i class="fa-solid fa-chevron-down"></i>
      </button>
      <script>
        document.querySelectorAll('.news-toggle').forEach((button) => {
          const news = button.closest('.news');
          const more = news.querySelector('.news-more');
          const label = button.querySelector('.news-toggle-label');

          more.addEventListener('transitionend', (e) => {
            // once fully open, let the height follow the content (e.g. on resize)
            if (e.target === more && e.propertyName === 'height' && more.classList.contains('is-open')) {
              more.style.height = 'auto';
            }
          });

          button.addEventListener('click', () => {
            const open = !more.classList.contains('is-open');
            button.setAttribute('aria-expanded', String(open));
            label.textContent = open ? 'Show fewer' : label.dataset.more;
            more.inert = !open;

            if (open) {
              more.style.height = more.scrollHeight + 'px';
              more.classList.add('is-open');
            } else {
              // animate from the current pixel height, not from 'auto'
              more.style.height = more.scrollHeight + 'px';
              more.getBoundingClientRect(); // force reflow so the collapse animates
              more.style.height = '0px';
              more.classList.remove('is-open');
              // if the top of the news list is off-screen, glide back to it instead of jumping
              if (news.getBoundingClientRect().top < 0) {
                news.scrollIntoView({ behavior: 'smooth', block: 'start' });
              }
            }
          });
        });
      </script>
    {% endif %}
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
